{
  "ruleset_name": "Legal Metrology (Packaged Commodities) Rules, 2011",
  "version": "2011-amended-2022",
  "governing_law": "Legal Metrology Act, 2009 & Packaged Commodities Rules, 2011",
  "rules": [
    {
      "rule_id": "LMPC-R6-MFG",
      "field": "manufacturer_name_and_address",
      "mandatory": true,
      "legal_reference": "Rule 6(1)(a)",
      "check_type": "presence",
      "violation_if_missing": "Manufacturer/packer/importer name and complete address not found on principal display panel.",
      "severity": "CRITICAL"
    },
    {
      "rule_id": "LMPC-R6-QTY",
      "field": "net_quantity",
      "mandatory": true,
      "legal_reference": "Rule 6(1)(b)",
      "check_type": "presence_and_format",
      "allowed_units": ["g", "gm", "gms", "kg", "kgs", "ml", "l", "ltr", "litre", "litres", "liter", "liters", "pieces", "pcs", "n", "units"],
      "format_regex": "^\\d+(?:\\.\\d+)?\\s*(?:kg|g|gm|gms|ml|l|ltr|litre|litres|liter|liters|pieces|pcs|n|units)",
      "violation_if_missing": "Net quantity declaration missing.",
      "violation_if_format_wrong": "Net quantity is not declared in prescribed standard units of weight, volume, or measure.",
      "severity": "CRITICAL"
    },
    {
      "rule_id": "LMPC-R6-MRP",
      "field": "mrp",
      "mandatory": true,
      "legal_reference": "Rule 6(1)(e)",
      "check_type": "presence_and_phrase",
      "must_contain_phrase": "inclusive of all taxes",
      "violation_if_missing": "Maximum Retail Price (MRP) declaration missing.",
      "violation_if_format_wrong": "MRP present but missing mandatory 'inclusive of all taxes' or 'incl. of all taxes' clause.",
      "severity": "CRITICAL"
    },
    {
      "rule_id": "LMPC-R6-DATE",
      "field": "month_year_of_manufacture_or_import",
      "mandatory": true,
      "legal_reference": "Rule 6(1)(d)",
      "check_type": "presence_and_format",
      "violation_if_missing": "Month and year of manufacture, packing, or import missing.",
      "violation_if_format_wrong": "Date of manufacture/packing not in standard format (MM/YYYY or DD/MM/YYYY).",
      "severity": "MAJOR"
    },
    {
      "rule_id": "LMPC-R6-CARE",
      "field": "consumer_care_details",
      "mandatory": true,
      "legal_reference": "Rule 6(1)(g)",
      "check_type": "presence_and_contact",
      "violation_if_missing": "Consumer care / grievance redressal contact details missing.",
      "violation_if_format_wrong": "Consumer care declaration incomplete (must provide telephone/toll-free number and/or email address).",
      "severity": "MAJOR"
    },
    {
      "rule_id": "LMPC-R6-ORIGIN",
      "field": "country_of_origin",
      "mandatory": false,
      "legal_reference": "Rule 6(1)(a) Proviso",
      "check_type": "conditional_presence",
      "condition": "if_imported",
      "violation_if_missing": "Country of origin not declared (mandatory for imported packaged goods).",
      "severity": "MINOR"
    },
    {
      "rule_id": "LMPC-R6-USP",
      "field": "unit_sale_price",
      "mandatory": true,
      "legal_reference": "Rule 6(1)(n) (2021 Amendment)",
      "check_type": "presence_and_format",
      "violation_if_missing": "Unit Sale Price (USP) missing (mandatory under Legal Metrology 2021 Amendment).",
      "violation_if_format_wrong": "Unit Sale Price format invalid (should be declared as Rs. X per g/kg/ml/litre/piece).",
      "severity": "MAJOR"
    }
  ],
  "font_size_rules": {
    "description": "Minimum font size (height of numerals & letters) based on Net Quantity under Rule 9 & Second Schedule of LMPC Rules, 2011",
    "slabs": [
      {
        "slab_id": "slab_1",
        "net_quantity_range": "Not exceeding 50 g / ml",
        "max_qty_grams_or_ml": 50,
        "min_numeral_height_mm": 1.0,
        "min_letter_height_mm": 1.0,
        "blown_moulded_min_height_mm": 1.5
      },
      {
        "slab_id": "slab_2",
        "net_quantity_range": "50 g/ml to 100 g/ml",
        "max_qty_grams_or_ml": 100,
        "min_numeral_height_mm": 1.5,
        "min_letter_height_mm": 1.5,
        "blown_moulded_min_height_mm": 2.0
      },
      {
        "slab_id": "slab_3",
        "net_quantity_range": "100 g/ml to 500 g/ml",
        "max_qty_grams_or_ml": 500,
        "min_numeral_height_mm": 2.0,
        "min_letter_height_mm": 2.0,
        "blown_moulded_min_height_mm": 3.0
      },
      {
        "slab_id": "slab_4",
        "net_quantity_range": "500 g/ml to 1 kg / l",
        "max_qty_grams_or_ml": 1000,
        "min_numeral_height_mm": 4.0,
        "min_letter_height_mm": 4.0,
        "blown_moulded_min_height_mm": 6.0
      },
      {
        "slab_id": "slab_5",
        "net_quantity_range": "Exceeding 1 kg / l",
        "max_qty_grams_or_ml": null,
        "min_numeral_height_mm": 6.0,
        "min_letter_height_mm": 6.0,
        "blown_moulded_min_height_mm": 9.0
      }
    ],
    "soft_flag_heuristic": {
      "method": "relative_bounding_box_height",
      "threshold_ratio_of_median": 0.40,
      "warning_message": "Possible readability issue — text height is unusually small relative to the package median font size. Verify physical packaging manually."
    }
  }
}
